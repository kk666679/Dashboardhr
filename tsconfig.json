{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["./components/shared/*"],
      "@modules/*": ["./components/modules/*"],
      "@platform/*": ["./components/platform/*"],
      "@charts/*": ["./components/charts/*"],
      "@dashboard-sidebar/*": ["./components/dashboard-sidebar/*"]
    },
    "plugins": [{ "name": "next" }],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
"exclude": ["node_modules", "WindowDownloader", ".openclaw"]
}
