# Normalise line endings to LF on commit; strip BOM on checkout
* text=auto eol=lf

# JSON must never have BOM
*.json text eol=lf working-tree-encoding=UTF-8

# Explicitly declare text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.env text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Binary files — no line-ending conversion, no diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.exe binary
*.zip binary
*.tar.gz binary
*.jar binary
