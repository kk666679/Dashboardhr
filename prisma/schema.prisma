generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model s_audits {
  id               String     @id
  tenantId         String
  area             String
  auditDate        DateTime
  auditorId        String?
  sortScore        FiveSScore @default(FAIR)
  setScore         FiveSScore @default(FAIR)
  shineScore       FiveSScore @default(FAIR)
  standardizeScore FiveSScore @default(FAIR)
  sustainScore     FiveSScore @default(FAIR)
  overallScore     Float?
  findings         String?    @db.Text
  actionItems      String?    @db.Text
  status           String     @default("OPEN")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime
  deletedAt        DateTime?
  employees        employees? @relation(fields: [auditorId], references: [id])
  tenants          tenants    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("5s_audits")
}

model ShiftToShiftPattern {
  A              String
  B              String
  shifts         shifts         @relation(fields: [A], references: [id], onDelete: Cascade)
  shift_patterns shift_patterns @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_ShiftToShiftPattern_AB_pkey")
  @@index([B], map: "_ShiftToShiftPattern_B_index")
  @@map("_ShiftToShiftPattern")
}

model access_revocation_requests {
  id                 String             @id
  tenantId           String
  accessRevocationId String
  system             RevocationSystem
  systemName         String?
  completed          Boolean            @default(false)
  completedAt        DateTime?
  remarks            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  deletedAt          DateTime?
  access_revocations access_revocations @relation(fields: [accessRevocationId], references: [id], onDelete: Cascade)
  tenants            tenants            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([accessRevocationId])
  @@index([tenantId])
}

model access_revocations {
  id                         String                       @id
  tenantId                   String
  terminationId              String                       @unique
  status                     AccessRevocationStatus       @default(PENDING)
  completedAt                DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  deletedAt                  DateTime?
  access_revocation_requests access_revocation_requests[]
  tenants                    tenants                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terminations               terminations                 @relation(fields: [terminationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([terminationId])
}

model accommodation_deductions {
  id           String   @id
  tenantId     String
  employeeId   String
  payrollRunId String?
  periodMonth  Int
  periodYear   Int
  hostelId     String?
  roomId       String?
  amount       Decimal  @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  tenants      tenants  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, periodYear, periodMonth])
  @@index([tenantId, employeeId])
}

model accommodations {
  id               String      @id
  tenantId         String
  name             String
  address          String?
  city             String?
  state            String?
  country          String?
  postalCode       String?
  type             String      @default("HOSTEL")
  capacity         Int         @default(0)
  currentOccupancy Int         @default(0)
  monthlyRent      Decimal?
  status           String      @default("ACTIVE")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime
  deletedAt        DateTime?
  tenants          tenants     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees        employees[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model addresses {
  id          String    @id
  tenantId    String
  employeeId  String
  addressType String    @default("HOME")
  line1       String
  line2       String?
  city        String?
  state       String?
  country     String    @default("MY")
  postalCode  String?
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  tenants     tenants   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
}

model agency_licenses {
  id                   String               @id
  tenantId             String
  agencyId             String
  licenseNo            String
  issuedBy             String?
  issuedDate           DateTime?
  expiryDate           DateTime?
  status               LicenseStatus        @default(ACTIVE)
  fileUrl              String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  deletedAt            DateTime?
  recruitment_agencies recruitment_agencies @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tenants              tenants              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, agencyId])
}

model ai_actions {
  id           String        @id
  tenantId     String
  workflowId   String?
  actionType   AIActionType
  target       String?
  payload      Json?
  executedAt   DateTime?
  result       Json?
  error        String?
  createdAt    DateTime      @default(now())
  tenants      tenants       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ai_workflows ai_workflows? @relation(fields: [workflowId], references: [id])

  @@index([tenantId, workflowId])
}

model ai_agents {
  id               String             @id
  tenantId         String
  name             String
  agentType        AIAgentType
  modelId          String?
  description      String?      @db.Text
  systemPrompt     String?      @db.Text
  config           Json?
  isActive         Boolean            @default(true)
  version          String             @default("1.0.0")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  deletedAt        DateTime?
  tenants          tenants            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ai_conversations ai_conversations[]
  ai_workflows     ai_workflows[]

  @@index([tenantId])
}

model ai_approvals {
  id             String             @id
  tenantId       String
  entityType     String
  entityId       String
  agentType      AIAgentType?
  recommendation String       @db.Text
  confidence     DecisionConfidence @default(MEDIUM)
  status         AIApprovalStatus   @default(PENDING)
  reviewedBy     String?
  reviewedAt     DateTime?
  notes          String?      @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime
  tenants        tenants            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, status])
}

model ai_conversations {
  id        String    @id
  tenantId  String
  agentId   String
  userId    String?
  sessionId String?
  messages  Json
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime
  deletedAt DateTime?
  ai_agents ai_agents @relation(fields: [agentId], references: [id])
  tenants   tenants   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentId])
}

model ai_extractions {
  id             String         @id
  tenantId       String
  ocrId          String
  fieldName      String
  fieldValue     String?
  confidence     Float?
  verified       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  ocr_processing ocr_processing @relation(fields: [ocrId], references: [id], onDelete: Cascade)

  @@index([tenantId, ocrId])
}

model ai_models {
  id           String       @id
  providerId   String
  modelId      String       @unique
  name         String
  description  String?
  maxTokens    Int?
  contextLen   Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  ai_providers ai_providers @relation(fields: [providerId], references: [id])

  @@index([providerId])
}

model ai_prompts {
  id              String            @id
  tenantId        String
  providerId      String?
  name            String
  description     String?
  category        String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  deletedAt       DateTime?
  ai_providers    ai_providers?     @relation(fields: [providerId], references: [id])
  tenants         tenants           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prompt_versions prompt_versions[]

  @@index([tenantId])
}

model ai_providers {
  id           String         @id
  code         String         @unique
  name         String
  providerType AIProviderType
  apiBaseUrl   String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  ai_models    ai_models[]
  ai_prompts   ai_prompts[]
}

model ai_recommendations {
  id             String             @id
  tenantId       String
  entityType     String
  entityId       String
  agentType      AIAgentType
  recommendation String       @db.Text
  reasoning      String?      @db.Text
  confidence     DecisionConfidence @default(MEDIUM)
  data           Json?
  isActioned     Boolean            @default(false)
  actionedAt     DateTime?
  actionedBy     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime
  deletedAt      DateTime?
  tenants        tenants            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
}

model ai_workflows {
  id          String                 @id
  tenantId    String
  agentId     String?
  name        String
  description String?
  trigger     AutomationTriggerType?
  steps       Json
  status      AIWorkflowStatus       @default(DRAFT)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  ai_actions  ai_actions[]
  ai_agents   ai_agents?             @relation(fields: [agentId], references: [id])
  tenants     tenants                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model alumni_profiles {
  id             String       @id
  tenantId       String
  employeeId     String       @unique
  terminationId  String       @unique
  personalEmail  String?
  linkedInUrl    String?
  currentCompany String?
  notes          String?
  status         AlumniStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  deletedAt      DateTime?
  employees      employees    @relation(fields: [employeeId], references: [id])
  tenants        tenants      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terminations   terminations @relation(fields: [terminationId], references: [id])

  @@index([tenantId])
}

model analytics_snapshots {
  id           String   @id
  tenantId     String
  snapshotType String
  data         Json
  takenAt      DateTime @default(now())
  period       String?
  createdAt    DateTime @default(now())
  tenants      tenants  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([takenAt])
  @@index([tenantId, snapshotType])
}

model api_clients {
  id               String           @id
  tenantId         String
  systemId         String
  clientId         String           @unique
  name             String
  scopes           String[]
  isActive         Boolean          @default(true)
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  deletedAt        DateTime?
  external_systems external_systems @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([tenantId, systemId])
}

model api_keys {
  id          String       @id
  tenantId    String
  userId      String
  name        String
  keyHash     String       @unique
  keyPrefix   String
  status      APIKeyStatus @default(ACTIVE)
  permissions String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  tenants     tenants      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model approval_delegates {
  id                String             @id
  tenantId          String
  requestId         String?
  originalId        String
  delegateId        String
  fromDate          DateTime
  toDate            DateTime
  reason            String?
  status            DelegationStatus   @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  approval_requests approval_requests? @relation(fields: [requestId], references: [id])
  tenants           tenants            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model approval_history {
  id                String            @id
  tenantId          String
  requestId         String
  step              Int
  approverId        String
  action            String
  comments          String?
  decidedAt         DateTime          @default(now())
  createdAt         DateTime          @default(now())
  approval_requests approval_requests @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([tenantId, requestId])
}

model approval_requests {
  id                 String               @id
  tenantId           String
  entityType         ApprovalEntityType
  entityId           String
  requestedBy        String
  title              String
  description        String?
  priority           String               @default("NORMAL")
  dueDate            DateTime?
  status             String               @default("PENDING")
  currentStep        Int                  @default(1)
  totalSteps         Int                  @default(1)
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  deletedAt          DateTime?
  approval_delegates approval_delegates[]
  approval_history   approval_history[]
  tenants            tenants              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, status])
}

model assessments {
  id           String           @id
  tenantId     String
  title        String
  description  String?
  type         String
  courseId     String?
  status       AssessmentStatus @default(DRAFT)
  maxScore     Int?
  passingScore Int?
  employeeId   String?
  score        Int?
  result       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime
  deletedAt    DateTime?
  courses      courses?         @relation(fields: [courseId], references: [id])
  employees    employees?       @relation(fields: [employeeId], references: [id])
  tenants      tenants          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, courseId])
  @@index([tenantId, employeeId])
}

model asset_return_items {
  id            String        @id
  tenantId      String
  assetReturnId String
  assetName     String
  assetTag      String?
  serialNumber  String?
  returned      Boolean       @default(false)
  returnedAt    DateTime?
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  deletedAt     DateTime?
  asset_returns asset_returns @relation(fields: [assetReturnId], references: [id], onDelete: Cascade)
  tenants       tenants       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([assetReturnId, assetTag])
  @@index([assetReturnId])
  @@index([tenantId])
}

model asset_returns {
  id                 String               @id
  tenantId           String
  terminationId      String               @unique
  status             AssetReturnStatus    @default(PENDING)
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  deletedAt          DateTime?
  asset_return_items asset_return_items[]
  tenants            tenants              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terminations       terminations         @relation(fields: [terminationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([terminationId])
}

model assets {
  id            String      @id
  tenantId      String
  employeeId    String?
  name          String
  category      String      @default("EQUIPMENT")
  serialNumber  String?
  assetTag      String?
  purchaseDate  DateTime?
  purchasePrice Decimal?
  assignedDate  DateTime?
  returnedDate  DateTime?
  status        AssetStatus @default(AVAILABLE)
  condition     String?
  location      String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  deletedAt     DateTime?
  employees     employees?  @relation(fields: [employeeId], references: [id])
  tenants       tenants     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId])
  @@index([tenantId, status])
}

model attendance_corrections {
  id           String                     @id
  tenantId     String
  employeeId   String
  attendanceId String?
  date         DateTime
  originalIn   DateTime?
  originalOut  DateTime?
  correctedIn  DateTime?
  correctedOut DateTime?
  reason       String
  status       AttendanceCorrectionStatus @default(PENDING)
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime
  tenants      tenants                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
}

model attendances {
  id          String           @id
  tenantId    String
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Decimal?
  status      AttendanceStatus @default(PRESENT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  employees   employees        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenants     tenants          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, date])
}

model audit_trail {
  id            String      @id
  tenantId      String
  entityType    String
  entityId      String
  action        AuditAction
  actorId       String?
  actorRole     Role?
  previousValue Json?
  newValue      Json?
  metadata      Json?
  createdAt     DateTime    @default(now())
  tenants       tenants     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([tenantId, entityType, entityId])
}

model automation_executions {
  id               String           @id
  tenantId         String
  ruleId           String
  entityType       String?
  entityId         String?
  triggered        DateTime         @default(now())
  completed        DateTime?
  success          Boolean?
  error            String?
  result           Json?
  createdAt        DateTime         @default(now())
  automation_rules automation_rules @relation(fields: [ruleId], references: [id])
  tenants          tenants          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ruleId])
}

model automation_rules {
  id                    String                  @id
  tenantId              String
  name                  String
  description           String?
  triggerType           AutomationTriggerType
  conditions            Json
  actions               Json
  status                AutomationRuleStatus    @default(DRAFT)
  lastRunAt             DateTime?
  nextRunAt             DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  deletedAt             DateTime?
  automation_executions automation_executions[]
  tenants               tenants                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model automation_triggers {
  id          String                @id
  tenantId    String
  name        String
  triggerType AutomationTriggerType
  entityType  String?
  conditions  Json?
  schedule    String?
  isActive    Boolean               @default(true)
  lastFiredAt DateTime?
  nextFireAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  tenants     tenants               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model bank_accounts {
  id          String          @id
  tenantId    String
  employeeId  String
  bankName    String
  accountNo   String
  accountName String
  accountType BankAccountType @default(SAVINGS)
  branchCode  String?
  swiftCode   String?
  isPrimary   Boolean         @default(false)
  isVerified  Boolean         @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  tenants     tenants         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, accountNo])
  @@index([tenantId, employeeId])
}

model beds {
  id         String   @id
  tenantId   String
  roomId     String
  bedNo      String
  isOccupied Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  rooms      rooms    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenants    tenants  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([roomId, bedNo])
  @@index([tenantId, roomId])
}

model biometric_devices {
  id                       String                     @id
  tenantId                 String
  deviceCode               String                     @unique
  name                     String
  deviceType               BiometricDeviceType
  location                 String?
  branchId                 String?
  ipAddress                String?
  macAddress               String?
  serialNo                 String?
  firmware                 String?
  isActive                 Boolean                    @default(true)
  lastSyncAt               DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  deletedAt                DateTime?
  tenants                  tenants                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  face_recognition_records face_recognition_records[]
  fingerprint_records      fingerprint_records[]

  @@index([tenantId])
}

model blacklist_statuses {
  id            String    @id
  tenantId      String
  employeeId    String    @unique
  reason        String
  blacklistedBy String?
  blacklistedAt DateTime  @default(now())
  liftedAt      DateTime?
  liftedBy      String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  tenants       tenants   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model bonus_plans {
  id                  String               @id
  tenantId            String
  cycleId             String?
  name                String
  description         String?
  eligibility         String?
  tiers               Json
  createdAt           DateTime             @default(now())
  updatedAt           DateTime
  deletedAt           DateTime?
  compensation_cycles compensation_cycles? @relation(fields: [cycleId], references: [id])
  tenants             tenants              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, cycleId])
}

model branches {
  id             String           @id
  tenantId       String
  companyId      String
  name           String
  code           String?
  address        String?
  city           String?
  state          String?
  country        String           @default("MY")
  phone          String?
  email          String?
  managerId      String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  deletedAt      DateTime?
  companies      companies        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenants        tenants          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  work_locations work_locations[]

  @@unique([companyId, code])
  @@index([tenantId])
}

model business_sectors {
  id          String             @id
  industryId  String
  code        String             @unique
  name        String
  sectorType  BusinessSectorType
  description String?
  isActive    Boolean            @default(true)
  industries  industries         @relation(fields: [industryId], references: [id])

  @@index([industryId])
}

model business_units {
  id          String    @id
  tenantId    String
  companyId   String
  name        String
  code        String?
  description String?
  headId      String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  companies   companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenants     tenants   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([tenantId])
}

model candidates {
  id              String          @id
  tenantId        String
  fullName        String
  email           String?
  phone           String?
  nationality     String?
  country         String?
  positionApplied String?
  resumeUrl       String?
  resumeText      String?
  parsedProfile   Json?
  status          CandidateStatus @default(NEW)
  backgroundCheck Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  deletedAt       DateTime?
  tenants         tenants         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, fullName])
  @@index([tenantId, status])
}

model capex_assets {
  id               String         @id
  tenantId         String
  projectId        String
  name             String
  serialNumber     String?
  purchaseDate     DateTime?
  purchasePrice    Decimal        @db.Decimal(18, 2)
  depreciationRate Float?
  currentValue     Decimal        @db.Decimal(18, 2)
  status           String         @default("ACTIVE")
  notes            String?
