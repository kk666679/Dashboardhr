  code          String?
  address       String?
  latitude      Float?
  longitude     Float?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  deletedAt     DateTime?
  branches      branches?      @relation(fields: [branchId], references: [id])
  factories     factories?     @relation(fields: [factoryId], references: [id])
  project_sites project_sites? @relation(fields: [projectSiteId], references: [id])
  tenants       tenants        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model work_permits {
  id         String         @id
  tenantId   String
  employeeId String
  permitNo   String?        @unique
  permitType WorkPermitType @default(PLKS)
  issuedDate DateTime
  expiryDate DateTime
  issuedBy   String?
  status     String         @default("ACTIVE")
  fileUrl    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime
  deletedAt  DateTime?
  tenants    tenants        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([expiryDate])
  @@index([tenantId, employeeId])
}

model work_schedules {
  id         String   @id
  tenantId   String
  rosterId   String
  employeeId String
  shiftId    String?
  workDate   DateTime
  isRestDay  Boolean  @default(false)
  isHoliday  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  rosters    rosters  @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  tenants    tenants  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([rosterId, employeeId, workDate])
  @@index([tenantId, employeeId])
}

model worker_allocations {
  id              String          @id
  tenantId        String
  foreignWorkerId String
  companyId       String?
  branchId        String?
  projectSiteId   String?
  allocatedDate   DateTime
  releasedDate    DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  deletedAt       DateTime?
  foreign_workers foreign_workers @relation(fields: [foreignWorkerId], references: [id])
  tenants         tenants         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, foreignWorkerId])
}

model worker_location_settings {
  id                       String    @id
  employeeId               String    @unique
  trackingEnabled          Boolean   @default(false)
  consentGiven             Boolean   @default(false)
  consentDate              DateTime?
  updateFrequency          Int       @default(5)
  privacyLevel             String    @default("standard")
  emergencyContactsEnabled Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime
  employees                employees @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model worker_placements {
  id          String    @id
  tenantId    String
  employeeId  String
  roomId      String
  bedId       String?
  moveInDate  DateTime
  moveOutDate DateTime?
  monthlyRate Decimal?  @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  rooms       rooms     @relation(fields: [roomId], references: [id])
  tenants     tenants   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, roomId])
}

model worker_profiles {
  id              String          @id
  tenantId        String
  foreignWorkerId String          @unique
  skillLevel      String?
  previousExp     String?
  languagesSpoken String[]
  healthStatus    String?
  medicalNotes    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  deletedAt       DateTime?
  foreign_workers foreign_workers @relation(fields: [foreignWorkerId], references: [id], onDelete: Cascade)
  tenants         tenants         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model workflow_definitions {
  id                 String               @id
  tenantId           String
  name               String
  version            Int                  @default(1)
  module             String
  graphJson          Json
  slaConfig          Json?
  isActive           Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  deletedAt          DateTime?
  tenants            tenants              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow_instances workflow_instances[]

  @@unique([tenantId, name, version])
}

model workflow_instance_steps {
  id                 String             @id
  instanceId         String
  stepId             String
  stepName           String
  assigneeId         String?
  assigneeRole       String?
  status             String             @default("PENDING")
  decidedBy          String?
  decision           String?
  comment            String?
  slaDeadline        DateTime?
  decidedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  deletedAt          DateTime?
  workflow_instances workflow_instances @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, status])
}

model workflow_instances {
  id                      String                    @id
  tenantId                String
  definitionId            String
  entityType              String
  entityId                String
  status                  String                    @default("ACTIVE")
  currentStepId           String?
  context                 Json?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  deletedAt               DateTime?
  workflow_instance_steps workflow_instance_steps[]
  workflow_definitions    workflow_definitions      @relation(fields: [definitionId], references: [id])
  tenants                 tenants                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, status])
}

model workforce_budgets {
  id          String       @id
  tenantId    String
  name        String
  description String?
  fiscalYear  Int
  totalBudget Decimal
  allocated   Decimal      @default(0)
  used        Decimal      @default(0)
  remaining   Decimal      @default(0)
  status      BudgetStatus @default(DRAFT)
  approvedBy  String?
  approvedAt  DateTime?
  lineItems   Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  tenants     tenants      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, fiscalYear])
}

model workforce_forecasts {
  id           String         @id
  tenantId     String
  name         String
  description  String?
  forecastDate DateTime       @default(now())
  horizon      String
  model        String?
  data         Json
  status       ForecastStatus @default(DRAFT)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  deletedAt    DateTime?
  tenants      tenants        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, forecastDate])
}

